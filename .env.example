# 日报文件名/标题使用的日历日（默认北京时间；GitHub Actions 已设为 Asia/Shanghai）
# REPORT_TIMEZONE=Asia/Shanghai

FEISHU_WEBHOOK_URL=
# 飞书推送模式：auto | wiki_link | markdown
# auto：已配置下方 APP + 知识库 ID 时走 wiki_link，否则回退 markdown 全文
FEISHU_NOTIFY_MODE=auto

# 飞书企业自建应用（知识库新建文档，必填才可使用 wiki_link）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_SPACE_ID=
# 可选：知识库父节点 token，不填则创建为空间一级节点
FEISHU_WIKI_PARENT_NODE_TOKEN=
# 可选：租户域名，如 https://your-company.feishu.cn
FEISHU_WIKI_BASE_URL=
# 可选：往期推送链接（不填则 Actions 用 GITHUB_REPOSITORY 自动生成）
# GITHUB_REPO_URL=https://github.com/peinengzhong/paper-weekly-agent
# GITHUB_REPO_BRANCH=main

MAX_PAPERS_TO_SUMMARIZE=20
RECENT_DAYS=30
MAX_RESULTS_PER_SOURCE=30

# arXiv API（可选；遇 429 / 超时时可调大延迟与超时）
ARXIV_CONTACT_EMAIL=peinengzhong@gmail.com
# ARXIV_REQUEST_TIMEOUT=60
# ARXIV_CONNECT_TIMEOUT=15
# ARXIV_MAX_RETRIES=3
# ARXIV_MIN_REQUEST_INTERVAL=3.5
# ARXIV_KEYWORD_DELAY=8
# ARXIV_COOLDOWN_SECONDS=8
# ARXIV_POST_429_DELAY=45
# ARXIV_RETRY_ROUND_COOLDOWN=90
# ARXIV_TOTAL_TIMEOUT_SECONDS=1200
# ARXIV_BULK_QUERY_MAX_KEYWORDS=0

# 多源检索（Semantic Scholar / OpenReview 默认启用；IEEE Xplore 需要 API Key）
ENABLE_SEMANTIC_SCHOLAR=true
# SEMANTIC_SCHOLAR_API_KEY=
# SEMANTIC_SCHOLAR_TIMEOUT=20
# SEMANTIC_SCHOLAR_KEYWORD_DELAY=1
# SEMANTIC_SCHOLAR_TOTAL_TIMEOUT_SECONDS=120

ENABLE_OPENREVIEW=true
# OPENREVIEW_TIMEOUT=20
# OPENREVIEW_KEYWORD_DELAY=1
# OPENREVIEW_TOTAL_TIMEOUT_SECONDS=120

ENABLE_IEEE_XPLORE=true
# IEEE_XPLORE_API_KEY=
# IEEE_XPLORE_TIMEOUT=20
# IEEE_XPLORE_KEYWORD_DELAY=1
# IEEE_XPLORE_TOTAL_TIMEOUT_SECONDS=120

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=1400
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_TIMEOUT=60
